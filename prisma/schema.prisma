// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String         @id @default(uuid())
  email      String         @unique
  name       String
  picture    String?
  systemRole SystemRole     @default(user)
  lastLogin  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tenants    TenantMember[]
}

enum SystemRole {
  user
  super_admin
}

model Tenant {
  id                String             @id @default(uuid())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  members           TenantMember[]
  invitations       Invitation[]
  phones            Phone[]
  flows             Flow[]
  intents           Intent[]
  products          Product[]
  promotions        Promotion[]
  shippingLocations ShippingLocation[]
  contactLabels          ContactLabel[]
  internalChannelReviews InternalChannelReview[]
  templates              Template[]
  settings          TenantSettings?
  memory            TenantMemory?
}

model TenantSettings {
  id                  String       @id @default(uuid())
  tenantId            String       @unique
  plan                Plan         @default(free)
  whatsappLimit       Int          @default(1)
  creditsLimit        Float        @default(0)
  creditsUsed         Float        @default(0)
  billingPeriodStart  DateTime     @default(now())
  analysisMode        AnalysisMode @default(manual)
  messageLimit        Int          @default(30)
  defaultShippingCost Float        @default(0)
  workSchedule        Json         @default("{\"1\":{\"start\":8,\"end\":18},\"2\":{\"start\":8,\"end\":18},\"3\":{\"start\":8,\"end\":18},\"4\":{\"start\":8,\"end\":18},\"5\":{\"start\":8,\"end\":18},\"6\":{\"start\":8,\"end\":12}}")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum TenantRole {
  owner
  user
  tecnico
}

model TenantMember {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  role      TenantRole @default(user)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model Invitation {
  id        String     @id @default(uuid())
  tenantId  String
  email     String
  role      TenantRole @default(user)
  token      String     @unique @default(uuid())
  expiresAt  DateTime
  acceptedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([token])
}

enum Plan {
  free
  full
}

// WhatsApp Models

model Phone {
  id                  String         @id @default(uuid())
  tenantId            String
  phoneNumber         String
  instanceName        String
  evolutionInstanceId String         @unique
  status              PhoneStatus    @default(pending)
  qrCode              String?
  lastConnected       DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations       Conversation[]

  @@index([tenantId])
  @@index([evolutionInstanceId])
}

model Client {
  id                 String                    @id @default(uuid())
  phoneNumber        String                    @unique
  name               String?
  profilePicUrl      String?
  metadata           Json?
  location           String?
  firstContactAt     DateTime                  @default(now())
  lastContactAt      DateTime                  @updatedAt
  memories           ClientMemory[]
  participations     ConversationParticipant[]
  discounts          Discount[]
  promotionDiscounts PromotionDiscount[]
  contactLabels          ContactLabel[]
  internalChannelReviews InternalChannelReview[]

  @@index([phoneNumber])
}

model ClientMemory {
  id        String   @id @default(uuid())
  clientId  String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, key])
  @@index([clientId])
}

model Conversation {
  id                 String               @id @default(uuid())
  phoneId            String
  type               ConversationType     @default(individual)
  groupJid           String?              @unique
  groupName          String?
  groupPictureUrl    String?
  mode               ConversationMode     @default(HITL)
  lastMessageAt      DateTime             @default(now())
  lastMessagePreview String?
  isActive           Boolean              @default(true)
  summary            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  phone              Phone                @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  messages           Message[]
  sessions           Session[]
  nodeSessions       NodeSession[]
  participants       ConversationParticipant[]
  stats              ConversationStats?
  analysis           ConversationAnalysis?

  @@index([phoneId])
  @@index([lastMessageAt])
}

model ConversationAnalysis {
  id              String                    @id @default(uuid())
  conversationId  String                    @unique
  intent          String?
  flowDiagram     String?
  flowSummary     String?
  isInternal      Boolean                   @default(false)
  internalPurpose String?
  analyzedAt      DateTime                  @default(now())
  conversation    Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  analysisFlows   ConversationAnalysisFlow[]
}

model ConversationAnalysisFlow {
  id         String               @id @default(uuid())
  analysisId String
  flowId     String
  createdAt  DateTime             @default(now())
  analysis   ConversationAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  flow       Flow                 @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([analysisId, flowId])
  @@index([analysisId])
  @@index([flowId])
}

model ConversationStats {
  id                   String       @id @default(uuid())
  conversationId       String       @unique
  lastMessageDirection String?
  unreadCount          Int          @default(0)
  updatedAt            DateTime     @updatedAt
  conversation         Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  clientId       String
  role           String       @default("member")
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientId])
  @@index([conversationId])
  @@index([clientId])
}

model Message {
  id             String            @id @default(uuid())
  conversationId String
  type           MessageType
  content        String
  mediaUrl       String?
  fileName       String?
  fileSize       Int?
  mimeType       String?
  direction      MessageDirection
  senderType     MessageSenderType
  status         MessageStatus     @default(pending)
  costUsd        Float?
  metadata       Json?
  transcription  String?
  analyzedAt     DateTime?
  createdAt      DateTime          @default(now())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  apiCalls       ApiCall[]
  mediaFiles     MediaFile[]

  @@index([conversationId])
  @@index([createdAt])
}

// Nodes & Flows

model Flow {
  id           String           @id @default(uuid())
  name         String
  routerNodeId String?
  tenantId     String
  status       FlowStatus       @default(active)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  routerNode   Node?            @relation("FlowRouter", fields: [routerNodeId], references: [id])
  nodes        FlowNode[]
  nodeSessions NodeSession[]
  intents      Intent[]
  transitions  FlowTransition[]
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  analysisFlows ConversationAnalysisFlow[]
  versions      FlowVersion[]

  @@index([tenantId])
}

model FlowVersion {
  id               String   @id @default(uuid())
  flowId           String
  version          Int
  nodesSnapshot    Json
  contentHash      String
  proposedTools    Json?
  isPromoted       Boolean  @default(false)
  consolidatedDiagram   String?
  nodeMapping      Json?
  diagramApproved  Boolean  @default(false)
  diagramModified  Boolean  @default(false)
  createdAt        DateTime @default(now())
  flow             Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, version])
  @@index([flowId])
}

model Node {
  id                   String        @id @default(uuid())
  name                 String
  systemPrompt         String
  tools                Json?
  preCode              String?
  preCodeInputSchema   Json?
  postCode             String?
  postCodeInputSchema  Json?
  todos                Json?
  onError              NodeOnError   @default(hitl)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  routerForFlows       Flow[]             @relation("FlowRouter")
  flowNodes            FlowNode[]
  currentNodeSessions  NodeSession[]      @relation("CurrentNode")
  transitionsFrom      FlowTransition[]   @relation("TransitionFrom")
  transitionsTo        FlowTransition[]   @relation("TransitionTo")
}

model FlowNode {
  id     String @id @default(uuid())
  flowId String
  nodeId String
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([flowId, nodeId])
  @@index([flowId])
  @@index([nodeId])
}

model FlowTransition {
  id             String   @id @default(uuid())
  flowId         String
  fromNodeId     String
  toNodeId       String
  transitionCode String
  requiredTodos  Json?

  flow           Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  fromNode       Node   @relation("TransitionFrom", fields: [fromNodeId], references: [id])
  toNode         Node   @relation("TransitionTo", fields: [toNodeId], references: [id])

  @@unique([flowId, transitionCode])
  @@index([flowId, fromNodeId])
}

model NodeSession {
  id             String            @id @default(uuid())
  conversationId String
  flowId         String?
  currentNodeId  String?
  detectedIntent String?
  flowSummary    String?
  cachedNodeData Json?
  completedTodos Json?
  status         NodeSessionStatus @default(active)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  flow           Flow?             @relation(fields: [flowId], references: [id])
  currentNode    Node?             @relation("CurrentNode", fields: [currentNodeId], references: [id])

  @@index([conversationId])
  @@index([flowId])
}

model Intent {
  id        String   @id @default(uuid())
  name      String
  tenantId  String
  flowId    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  flow      Flow?    @relation(fields: [flowId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

// AI & HITL Models

model Session {
  id             String       @id @default(uuid())
  conversationId String
  type           SessionType
  flowData       Json         @default("{}")
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  endedBy        String?
  takenBy        String?
  reason         String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model ApiCall {
  id           String   @id @default(uuid())
  messageId    String
  apiType      ApiType
  operation    String
  tokensInput  Int?
  tokensOutput Int?
  costUsd      Float
  latencyMs    Int
  errorMessage String?
  calledAt     DateTime @default(now())
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([calledAt])
}

model MediaFile {
  id              String    @id @default(uuid())
  messageId       String
  type            MediaType
  storagePath     String
  whatsappMediaId String?
  sizeBytes       Int?
  durationSeconds Float?
  message         Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model TenantMemory {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ApiHealth {
  id               String       @id @default(uuid())
  apiName          ApiName      @unique
  status           HealthStatus @default(up)
  monitoringActive Boolean      @default(true)
  responseTimeMs   Int?
  errorMessage     String?
  lastErrorAt      DateTime?
  lastCheckAt      DateTime?
  recoveredAt      DateTime?

  @@index([apiName])
}

// WhatsApp Enums

enum PhoneStatus {
  connected
  disconnected
  pending
}

enum MessageType {
  text
  voice
  image
  video
  audio
  document
}

enum MessageDirection {
  incoming
  outgoing
}

enum MessageSenderType {
  client
  agent
  bot
  system
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

// AI & HITL Enums

enum ConversationMode {
  AI
  HITL
}

enum ConversationType {
  individual
  group
}

enum SessionType {
  AI
  HITL
}

enum NodeOnError {
  hitl
  log
  retry
}

enum NodeSessionStatus {
  active
  waiting_queue
  closed
}

enum SecurityEventType {
  prompt_injection
  suspicious_activity
  unauthorized_access
}

model SecurityEvent {
  id             String            @id @default(uuid())
  type           SecurityEventType
  userId         String
  conversationId String?
  clientPhone    String?
  description    String
  metadata       Json?
  createdAt      DateTime          @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Template {
  id        String   @id @default(uuid())
  code      String
  content   String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([code, tenantId])
  @@index([tenantId])
}

enum ApiType {
  qwen_stt
  kimi_llm
  qwen_tts
  kimi_flow_analyzer
}

enum MediaType {
  audio
  image
  video
  document
}

enum ApiName {
  qwen_stt
  kimi_llm
  qwen_tts
}

enum HealthStatus {
  up
  down
  degraded
}

// Conversation Analysis Models

enum AnalysisMode {
  automatic
  manual
}

enum FlowStatus {
  active
  draft
  archived
}

enum LabelStatus {
  active
  draft
}

enum InternalReviewStatus {
  pending
  approved
  rejected
}


model ShippingLocation {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  isFreeShipping Boolean  @default(false)
  shippingCost   Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id                String             @id @default(uuid())
  tenantId          String
  name              String
  basePrice         Float
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discounts         Discount[]
  promotionProducts PromotionProduct[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Discount {
  id            String   @id @default(uuid())
  productId     String
  clientId      String?
  discountPrice Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([productId, discountPrice])
  @@index([productId])
  @@index([clientId])
}

model Promotion {
  id                 String              @id @default(uuid())
  tenantId           String
  name               String?
  description        String?
  specialPrice       Float
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotionProducts  PromotionProduct[]
  promotionDiscounts PromotionDiscount[]

  @@index([tenantId])
}

model PromotionProduct {
  id          String    @id @default(uuid())
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([promotionId])
  @@index([productId])
}

model PromotionDiscount {
  id            String    @id @default(uuid())
  promotionId   String
  clientId      String?
  discountPrice Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  promotion     Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([promotionId, discountPrice])
  @@index([promotionId])
  @@index([clientId])
}

// Queue System

model ContactLabel {
  id        String      @id @default(uuid())
  tenantId  String
  label     String
  clientId  String?
  groupJid  String?
  status    LabelStatus @default(active)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, label])
  @@index([tenantId])
}

model InternalChannelReview {
  id               String               @id @default(uuid())
  tenantId         String
  clientId         String?
  groupJid         String?
  internalPurpose  String?
  channelName      String?
  status           InternalReviewStatus @default(pending)
  modifiedPurpose  String?
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId, groupJid])
  @@index([tenantId])
}

model QueueRequest {
  id               String             @id @default(uuid())
  userId           String
  nodeSessionId    String
  conversationId   String
  currentNodeId    String
  instanceName     String
  label            String
  destinationPhone String
  groupJid         String?
  outgoingMessage  String
  imageUrl         String?
  isTest           Boolean            @default(false)
  responseMessage  String?
  toolName         String
  toolContext       Json?
  status           QueueRequestStatus @default(pending)
  sentAt           DateTime?
  respondedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([nodeSessionId])
  @@index([destinationPhone, status])
  @@index([instanceName, destinationPhone, status])
}

enum QueueRequestStatus {
  pending
  sent
  responded
  expired
  cancelled
}
