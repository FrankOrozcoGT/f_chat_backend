// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  name               String
  picture            String?
  plan               Plan          @default(free)
  role               Role          @default(free)
  whatsappLimit      Int           @default(1)
  creditsLimit       Float         @default(0)
  creditsUsed        Float         @default(0)
  billingPeriodStart DateTime      @default(now())
  lastLogin          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  phones             Phone[]
  settings           UserSettings?
  products           Product[]
  promotions         Promotion[]
  shippingLocations  ShippingLocation[]
  contactLabels      ContactLabel[]
}

enum Plan {
  free
  full
}

enum Role {
  free
  full
  admin
}

// WhatsApp Models

model Phone {
  id                  String         @id @default(uuid())
  userId              String
  phoneNumber         String
  instanceName        String
  evolutionInstanceId String         @unique
  status              PhoneStatus    @default(pending)
  qrCode              String?
  lastConnected       DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations       Conversation[]

  @@index([userId])
  @@index([evolutionInstanceId])
}

model Client {
  id                 String                    @id @default(uuid())
  phoneNumber        String                    @unique
  name               String?
  profilePicUrl      String?
  metadata           Json?
  location           String?
  firstContactAt     DateTime                  @default(now())
  lastContactAt      DateTime                  @updatedAt
  memories           ClientMemory[]
  participations     ConversationParticipant[]
  discounts          Discount[]
  promotionDiscounts PromotionDiscount[]
  contactLabels      ContactLabel[]

  @@index([phoneNumber])
}

model ClientMemory {
  id        String   @id @default(uuid())
  clientId  String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, key])
  @@index([clientId])
}

model Conversation {
  id                 String               @id @default(uuid())
  phoneId            String
  type               ConversationType     @default(individual)
  groupJid           String?              @unique
  groupName          String?
  groupPictureUrl    String?
  mode               ConversationMode     @default(HITL)
  lastMessageAt      DateTime             @default(now())
  lastMessagePreview String?
  isActive           Boolean              @default(true)
  summary            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  phone              Phone                @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  messages           Message[]
  sessions           Session[]
  nodeSessions       NodeSession[]
  participants       ConversationParticipant[]

  @@index([phoneId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  clientId       String
  role           String       @default("member")
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientId])
  @@index([conversationId])
  @@index([clientId])
}

model Message {
  id             String            @id @default(uuid())
  conversationId String
  type           MessageType
  content        String
  mediaUrl       String?
  fileName       String?
  fileSize       Int?
  mimeType       String?
  direction      MessageDirection
  senderType     MessageSenderType
  status         MessageStatus     @default(pending)
  costUsd        Float?
  metadata       Json?
  transcription  String?
  analyzedAt     DateTime?
  createdAt      DateTime          @default(now())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  apiCalls       ApiCall[]
  mediaFiles     MediaFile[]

  @@index([conversationId])
  @@index([createdAt])
}

// Nodes & Flows

model Flow {
  id           String        @id @default(uuid())
  name         String
  routerNodeId String
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  routerNode   Node          @relation("FlowRouter", fields: [routerNodeId], references: [id])
  nodes        FlowNode[]
  nodeSessions NodeSession[]
  intents      Intent[]

  @@index([userId])
}

model Node {
  id                   String        @id @default(uuid())
  name                 String
  systemPrompt         String
  tools                Json?
  preCode              String?
  preCodeInputSchema   Json?
  postCode             String?
  postCodeInputSchema  Json?
  onError              NodeOnError   @default(hitl)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  routerForFlows       Flow[]        @relation("FlowRouter")
  flowNodes            FlowNode[]
  currentNodeSessions  NodeSession[] @relation("CurrentNode")
}

model FlowNode {
  id     String @id @default(uuid())
  flowId String
  nodeId String
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([flowId, nodeId])
  @@index([flowId])
  @@index([nodeId])
}

model NodeSession {
  id             String            @id @default(uuid())
  conversationId String
  flowId         String?
  currentNodeId  String?
  detectedIntent String?
  flowSummary    String?
  status         NodeSessionStatus @default(active)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  flow           Flow?             @relation(fields: [flowId], references: [id])
  currentNode    Node?             @relation("CurrentNode", fields: [currentNodeId], references: [id])

  @@index([conversationId])
  @@index([flowId])
}

model Intent {
  id        String   @id @default(uuid())
  name      String
  userId    String
  flowId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  flow      Flow?    @relation(fields: [flowId], references: [id])

  @@unique([userId, name])
  @@index([userId])
}

// AI & HITL Models

model Session {
  id             String       @id @default(uuid())
  conversationId String
  type           SessionType
  flowData       Json         @default("{}")
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  endedBy        String?
  takenBy        String?
  reason         String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model ApiCall {
  id           String   @id @default(uuid())
  messageId    String
  apiType      ApiType
  operation    String
  tokensInput  Int?
  tokensOutput Int?
  costUsd      Float
  latencyMs    Int
  errorMessage String?
  calledAt     DateTime @default(now())
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([calledAt])
}

model MediaFile {
  id              String    @id @default(uuid())
  messageId       String
  type            MediaType
  storagePath     String
  whatsappMediaId String?
  sizeBytes       Int?
  durationSeconds Float?
  message         Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ApiHealth {
  id               String       @id @default(uuid())
  apiName          ApiName      @unique
  status           HealthStatus @default(up)
  monitoringActive Boolean      @default(true)
  responseTimeMs   Int?
  errorMessage     String?
  lastErrorAt      DateTime?
  lastCheckAt      DateTime?
  recoveredAt      DateTime?

  @@index([apiName])
}

// WhatsApp Enums

enum PhoneStatus {
  connected
  disconnected
  pending
}

enum MessageType {
  text
  voice
  image
  video
  audio
  document
}

enum MessageDirection {
  incoming
  outgoing
}

enum MessageSenderType {
  client
  agent
  bot
  system
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

// AI & HITL Enums

enum ConversationMode {
  AI
  HITL
}

enum ConversationType {
  individual
  group
}

enum SessionType {
  AI
  HITL
}

enum NodeOnError {
  hitl
  log
  retry
}

enum NodeSessionStatus {
  active
  waiting_queue
  closed
}

enum SecurityEventType {
  prompt_injection
  suspicious_activity
  unauthorized_access
}

model SecurityEvent {
  id             String            @id @default(uuid())
  type           SecurityEventType
  userId         String
  conversationId String?
  clientPhone    String?
  description    String
  metadata       Json?
  createdAt      DateTime          @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Template {
  id        String   @id @default(uuid())
  code      String
  content   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, userId])
  @@index([userId])
}

enum ApiType {
  qwen_stt
  kimi_llm
  qwen_tts
  kimi_flow_analyzer
}

enum MediaType {
  audio
  image
  video
  document
}

enum ApiName {
  qwen_stt
  kimi_llm
  qwen_tts
  node
}

enum HealthStatus {
  up
  down
  degraded
}

// Conversation Analysis Models

enum AnalysisMode {
  automatic
  manual
}

model UserSettings {
  id           String       @id @default(uuid())
  userId       String       @unique
  analysisMode        AnalysisMode @default(manual)
  messageLimit        Int          @default(30)
  defaultShippingCost Float        @default(0)
  workStartHour       Int          @default(8)
  workEndHour         Int          @default(17)
  workDays            String       @default("1,2,3,4,5")
  createdAt           DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShippingLocation {
  id             String  @id @default(uuid())
  userId         String
  name           String
  isFreeShipping Boolean @default(false)
  shippingCost   Float   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model Product {
  id                String             @id @default(uuid())
  userId            String
  name              String
  basePrice         Float
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  discounts         Discount[]
  promotionProducts PromotionProduct[]

  @@unique([userId, name])
  @@index([userId])
}

model Discount {
  id            String   @id @default(uuid())
  productId     String
  clientId      String?
  discountPrice Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([productId, discountPrice])
  @@index([productId])
  @@index([clientId])
}

model Promotion {
  id                 String              @id @default(uuid())
  userId             String
  name               String?
  description        String?
  specialPrice       Float
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotionProducts  PromotionProduct[]
  promotionDiscounts PromotionDiscount[]

  @@index([userId])
}

model PromotionProduct {
  id          String    @id @default(uuid())
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([promotionId])
  @@index([productId])
}

model PromotionDiscount {
  id            String    @id @default(uuid())
  promotionId   String
  clientId      String?
  discountPrice Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  promotion     Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([promotionId, discountPrice])
  @@index([promotionId])
  @@index([clientId])
}

// Queue System

model ContactLabel {
  id        String   @id @default(uuid())
  userId    String
  label     String
  clientId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId])
}

model QueueRequest {
  id               String             @id @default(uuid())
  userId           String
  nodeSessionId    String
  conversationId   String
  currentNodeId    String
  instanceName     String
  label            String
  destinationPhone String
  outgoingMessage  String
  responseMessage  String?
  toolName         String
  toolContext       Json?
  status           QueueRequestStatus @default(pending)
  sentAt           DateTime?
  respondedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([nodeSessionId])
  @@index([destinationPhone, status])
  @@index([instanceName, destinationPhone, status])
}

enum QueueRequestStatus {
  pending
  sent
  responded
  expired
  cancelled
}
