// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  name               String
  picture            String?
  plan               Plan          @default(free)
  role               Role          @default(free)
  whatsappLimit      Int           @default(1)
  creditsLimit       Float         @default(0)
  creditsUsed        Float         @default(0)
  billingPeriodStart DateTime      @default(now())
  lastLogin          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  phones             Phone[]
  settings           UserSettings?
  products           Product[]
  promotions         Promotion[]
}

enum Plan {
  free
  full
}

enum Role {
  free
  full
  admin
}

// WhatsApp Models

model Phone {
  id                  String         @id @default(uuid())
  userId              String
  phoneNumber         String
  instanceName        String
  evolutionInstanceId String         @unique
  status              PhoneStatus    @default(pending)
  qrCode              String?
  lastConnected       DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations       Conversation[]

  @@index([userId])
  @@index([evolutionInstanceId])
}

model Client {
  id                 String                    @id @default(uuid())
  phoneNumber        String                    @unique
  name               String?
  profilePicUrl      String?
  metadata           Json?
  firstContactAt     DateTime                  @default(now())
  lastContactAt      DateTime                  @updatedAt
  memories           ClientMemory[]
  participations     ConversationParticipant[]
  discounts          Discount[]
  promotionDiscounts PromotionDiscount[]

  @@index([phoneNumber])
}

model ClientMemory {
  id        String   @id @default(uuid())
  clientId  String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, key])
  @@index([clientId])
}

model Conversation {
  id                 String               @id @default(uuid())
  phoneId            String
  type               ConversationType     @default(individual)
  groupJid           String?              @unique
  groupName          String?
  groupPictureUrl    String?
  mode               ConversationMode     @default(HITL)
  lastMessageAt      DateTime             @default(now())
  lastMessagePreview String?
  isActive           Boolean              @default(true)
  summary            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  phone              Phone                @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  messages           Message[]
  sessions           Session[]
  participants       ConversationParticipant[]

  @@index([phoneId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  clientId       String
  role           String       @default("member")
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientId])
  @@index([conversationId])
  @@index([clientId])
}

model Message {
  id             String            @id @default(uuid())
  conversationId String
  type           MessageType
  content        String
  mediaUrl       String?
  fileName       String?
  fileSize       Int?
  mimeType       String?
  direction      MessageDirection
  senderType     MessageSenderType
  status         MessageStatus     @default(pending)
  costUsd        Float?
  metadata       Json?
  transcription  String?
  analyzedAt     DateTime?
  createdAt      DateTime          @default(now())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  apiCalls       ApiCall[]
  mediaFiles     MediaFile[]

  @@index([conversationId])
  @@index([createdAt])
}

// AI & HITL Models

model Session {
  id             String       @id @default(uuid())
  conversationId String
  type           SessionType
  flowData       Json         @default("{}")
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  endedBy        String?
  takenBy        String?
  reason         String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model ApiCall {
  id           String   @id @default(uuid())
  messageId    String
  apiType      ApiType
  operation    String
  tokensInput  Int?
  tokensOutput Int?
  costUsd      Float
  latencyMs    Int
  errorMessage String?
  calledAt     DateTime @default(now())
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([calledAt])
}

model MediaFile {
  id              String    @id @default(uuid())
  messageId       String
  type            MediaType
  storagePath     String
  whatsappMediaId String?
  sizeBytes       Int?
  durationSeconds Float?
  message         Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ApiHealth {
  id               String       @id @default(uuid())
  apiName          ApiName      @unique
  status           HealthStatus @default(up)
  monitoringActive Boolean      @default(true)
  responseTimeMs   Int?
  errorMessage     String?
  lastErrorAt      DateTime?
  lastCheckAt      DateTime?
  recoveredAt      DateTime?

  @@index([apiName])
}

// WhatsApp Enums

enum PhoneStatus {
  connected
  disconnected
  pending
}

enum MessageType {
  text
  voice
  image
  video
  audio
  document
}

enum MessageDirection {
  incoming
  outgoing
}

enum MessageSenderType {
  client
  agent
  bot
  system
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

// AI & HITL Enums

enum ConversationMode {
  AI
  HITL
}

enum ConversationType {
  individual
  group
}

enum SessionType {
  AI
  HITL
}

enum ApiType {
  qwen_stt
  kimi_llm
  qwen_tts
  kimi_flow_analyzer
}

enum MediaType {
  audio
  image
  video
  document
}

enum ApiName {
  qwen_stt
  kimi_llm
  qwen_tts
}

enum HealthStatus {
  up
  down
  degraded
}

// Conversation Analysis Models

enum AnalysisMode {
  automatic
  manual
}

model UserSettings {
  id           String       @id @default(uuid())
  userId       String       @unique
  analysisMode AnalysisMode @default(manual)
  messageLimit Int          @default(30)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                String             @id @default(uuid())
  userId            String
  name              String
  basePrice         Float
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  discounts         Discount[]
  promotionProducts PromotionProduct[]

  @@unique([userId, name])
  @@index([userId])
}

model Discount {
  id            String   @id @default(uuid())
  productId     String
  clientId      String?
  discountPrice Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([productId, discountPrice])
  @@index([productId])
  @@index([clientId])
}

model Promotion {
  id                 String              @id @default(uuid())
  userId             String
  name               String?
  description        String?
  specialPrice       Float
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotionProducts  PromotionProduct[]
  promotionDiscounts PromotionDiscount[]

  @@index([userId])
}

model PromotionProduct {
  id          String    @id @default(uuid())
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([promotionId])
  @@index([productId])
}

model PromotionDiscount {
  id            String    @id @default(uuid())
  promotionId   String
  clientId      String?
  discountPrice Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  promotion     Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([promotionId, discountPrice])
  @@index([promotionId])
  @@index([clientId])
}
